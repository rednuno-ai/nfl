{
  "name": "nfl-life",
  "version": "0.1.1",
  "private": true,
  "description": "NFL LIFE — a football career & life simulator. Create an athlete, live High School through retirement, and build your legacy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sandbox": "tsx --test src/engine/__tests__/*.test.ts",
    "build:sandbox": "node tools/sandbox/esbuild-build.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@cloudflare/vite-plugin": "^1.53.0",
    "typescript": "^5.6.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.125.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
